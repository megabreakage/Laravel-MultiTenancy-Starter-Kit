{
    "name": "iosync/laravel-api-kit",
    "type": "project",
    "description": "Production-ready, API-only multi-tenant Laravel 13 starter kit.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "stancl/tenancy": "^3.9",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-query-builder": "^7.0",
        "spatie/laravel-permission": "^6.0|^7.0",
        "spatie/laravel-responsecache": "^8.0",
        "owen-it/laravel-auditing": "^14.0",
        "laravel/scout": "^10.0|^11.0",
        "meilisearch/meilisearch-php": "^1.10",
        "dedoc/scramble": ">=0.12",
        "grazulex/laravel-apiroute": "^2.0",
        "sentry/sentry-laravel": "^4.0",
        "laravel/horizon": "^5.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.0",
        "driftingly/rector-laravel": "^2.3",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "./vendor/bin/pest --parallel --processes=4",
        "test:seq": "./vendor/bin/pest",
        "test:full": "./vendor/bin/pest --parallel --exclude-group=serial && ./vendor/bin/pest --group=serial",
        "analyze": "./vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "lint": "./vendor/bin/pint --test",
        "fix": "./vendor/bin/pint",
        "check": "@lint && @analyze && @test:full"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
